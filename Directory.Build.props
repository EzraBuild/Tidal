<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <!-- Plain .NET for the parts that run on every operating system... -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- ...and Windows 10 2004+ for the Windows projects, for the WinRT light sensor and location APIs. -->
    <WindowsTargetFramework>net8.0-windows10.0.19041.0</WindowsTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Tidal</Product>
    <Version>0.1.5</Version>
  </PropertyGroup>
</Project>
