<ui:FluentWindow x:Class="Tidal.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Tidal.App.ViewModels"
                 xmlns:controls="clr-namespace:Tidal.App.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
                 Title="Tidal Settings"
                 Width="560" Height="780" MinWidth="460" MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Error line under a shortcut; collapses when there's no error. -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!-- One card per display. -->
        <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Primary" FontSize="11"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8"
                                   Icon="{ui:SymbolIcon ArrowClockwise20}"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Read current values from the display" />
                    </Grid>

                    <Grid Margin="0,16,0,0" Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="BrightnessHigh20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Brightness" Style="{StaticResource Label}" />
                        <Slider Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                ToolTip="{Binding LimitsDescription}"
                                AutomationProperties.Name="{Binding Name, StringFormat={}{0} brightness}"
                                Value="{Binding Brightness}" />
                        <TextBlock Grid.Column="3" Text="{Binding Brightness, StringFormat={}{0:0}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid Margin="0,8,0,0" Visibility="{Binding SupportsContrast, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DarkTheme20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Contrast" Style="{StaticResource Label}" />
                        <Slider Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                AutomationProperties.Name="{Binding Name, StringFormat={}{0} contrast}"
                                Value="{Binding Contrast}" />
                        <TextBlock Grid.Column="3" Text="{Binding Contrast, StringFormat={}{0:0}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Brightness limits: everything Tidal sets stays in this band. -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="BrightnessLow20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Limits" Style="{StaticResource Label}"
                                   ToolTip="Sliders, shortcuts and Link all keep this display between these values" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ui:NumberBox Width="128" ClearButtonEnabled="False" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                          MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline"
                                          AutomationProperties.Name="{Binding Name, StringFormat={}{0} lowest brightness}"
                                          Value="{Binding MinBrightness, Mode=TwoWay}" />
                            <TextBlock Text="to" Margin="8,0" Style="{StaticResource Label}" />
                            <ui:NumberBox Width="128" ClearButtonEnabled="False" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                          MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline"
                                          AutomationProperties.Name="{Binding Name, StringFormat={}{0} highest brightness}"
                                          Value="{Binding MaxBrightness, Mode=TwoWay}" />
                            <TextBlock Text="%" Margin="6,0,0,0" Style="{StaticResource Label}" />
                        </StackPanel>
                    </Grid>

                    <ui:InfoBar Margin="0,12,0,0" Severity="Warning" IsClosable="False"
                                Title="No hardware control"
                                Message="{Binding Note}"
                                IsOpen="{Binding HasNote, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Tidal Settings" />

        <ScrollViewer Grid.Row="1" Padding="20,4,20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Displays -->
                <Grid DataContext="{Binding Displays}" Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Displays" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Detect again" VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon ArrowClockwise20}"
                               Command="{Binding RefreshCommand}" />
                </Grid>

                <Grid DataContext="{Binding Displays}">
                    <ItemsControl ItemsSource="{Binding Displays}" Focusable="False" />
                    <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" Margin="0,40,0,40"
                                     VerticalAlignment="Top" HorizontalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Shortcuts -->
                <TextBlock Text="Brightness shortcuts" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                           Text="Work in any app. Hold the keys to keep going. Click a shortcut, then press new keys; Esc cancels, Backspace clears." />

                <Border Style="{StaticResource Card}" DataContext="{Binding Shortcuts}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowUp20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Brighter" Style="{StaticResource Label}" />
                            <controls:ShortcutBox Grid.Column="2"
                                                  AutomationProperties.Name="Brighter shortcut"
                                                  Shortcut="{Binding BrightnessUp}"
                                                  IsRecording="{Binding IsRecordingUp}" />
                        </Grid>
                        <TextBlock Text="{Binding BrightnessUpError}" Style="{StaticResource ErrorText}" Margin="28,4,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowDown20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Dimmer" Style="{StaticResource Label}" />
                            <controls:ShortcutBox Grid.Column="2"
                                                  AutomationProperties.Name="Dimmer shortcut"
                                                  Shortcut="{Binding BrightnessDown}"
                                                  IsRecording="{Binding IsRecordingDown}" />
                        </Grid>
                        <TextBlock Text="{Binding BrightnessDownError}" Style="{StaticResource ErrorText}" Margin="28,4,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="BrightnessHigh20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Change per press" Style="{StaticResource Label}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:NumberBox Width="128" ClearButtonEnabled="False" Minimum="1" Maximum="50" SmallChange="1" LargeChange="5"
                                              MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline"
                                              AutomationProperties.Name="Change per press"
                                              Value="{Binding Step, Mode=TwoWay}" />
                                <TextBlock Text="%" Margin="6,0,0,0" Style="{StaticResource Label}" />
                            </StackPanel>
                        </Grid>

                        <ui:ToggleSwitch Margin="0,14,0,0"
                                         Content="Only change the display under the mouse pointer"
                                         IsChecked="{Binding OnlyDisplayUnderPointer}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
