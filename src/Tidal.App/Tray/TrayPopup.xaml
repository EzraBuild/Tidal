<ui:FluentWindow x:Class="Tidal.App.Tray.TrayPopup"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Tidal.App.ViewModels"
                 xmlns:controls="clr-namespace:Tidal.App.Controls"
                 xmlns:behaviors="clr-namespace:Tidal.App.Behaviors"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:AppViewModel}"
                 Title="Tidal"
                 Width="360"
                 MinWidth="0"
                 MinHeight="0"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="RoundSmall"
                 FontFamily="{StaticResource TidalFont}"
                 Background="{DynamicResource TidalBackgroundBrush}"
                 Foreground="{DynamicResource TidalTextBrush}">

    <Border BorderThickness="1" BorderBrush="{DynamicResource TidalBorderBrush}" Background="{DynamicResource TidalBackgroundBrush}">
        <Grid x:Name="Root">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: wordmark and what brightness follows. -->
            <Grid Margin="16,12,12,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:LogoMark Width="18" Height="18" />
                    <TextBlock Text="TIDAL." Margin="8,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource TidalMonoFont}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
                <controls:ModePicker DataContext="{Binding Adaptive}" HorizontalAlignment="Right" />
            </Grid>
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Style="{StaticResource TidalDashedLine}" />

            <!-- Adaptive status, only when adaptive brightness is on. -->
            <Border Grid.Row="1" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TidalBorderBrush}"
                    Background="{DynamicResource TidalSurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Adaptive.IsOff}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Adaptive.Status}" FontFamily="{StaticResource TidalMonoFont}" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource TidalMutedBrush}" />
            </Border>

            <!-- One block per display. -->
            <Grid Grid.Row="2">
                <TextBlock Text="{Binding Displays.EmptyMessage}" Margin="16,20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TidalCaption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Displays.EmptyMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Displays.Displays}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                            <Grid>
                                <StackPanel Margin="16,14,16,14">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,64,0" />
                                        <Border Style="{StaticResource TidalTag}" HorizontalAlignment="Right"
                                                ToolTip="Adaptive brightness is adjusting this display"
                                                Visibility="{Binding IsFollowingAdaptive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="AUTO" />
                                        </Border>
                                    </Grid>

                                    <Slider Margin="0,10,0,0" Style="{StaticResource TidalSlider}"
                                            behaviors:SliderWheel.Step="2"
                                            ToolTip="{Binding LimitsDescription}"
                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0} brightness}"
                                            Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}"
                                            Value="{Binding Brightness}" />

                                    <Slider Margin="0,6,0,0" Style="{StaticResource TidalVolumeSlider}"
                                            behaviors:SliderWheel.Step="2"
                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0} volume}"
                                            Visibility="{Binding SupportsVolume, Converter={StaticResource BoolToVisibility}}"
                                            Value="{Binding Volume}" />

                                    <controls:InputPicker Margin="0,8,0,0" HorizontalAlignment="Left"
                                                          Visibility="{Binding HasInputs, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Margin="0,6,0,0" Text="No hardware control" ToolTip="{Binding Note}"
                                               Style="{StaticResource TidalCaption}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Rectangle Height="1" VerticalAlignment="Bottom" Style="{StaticResource TidalDashedLine}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Presets: a fraction of each display's own range. -->
            <Grid Grid.Row="3" Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PRESETS" Style="{StaticResource TidalEyebrow}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <UniformGrid Grid.Column="1" Columns="5">
                    <Button Style="{StaticResource TidalChipButton}" Padding="0,5" Content="0%"
                            Command="{Binding Displays.ApplyPresetCommand}" CommandParameter="0" />
                    <Button Style="{StaticResource TidalChipButton}" Padding="0,5" Margin="-1,0,0,0" Content="25%"
                            Command="{Binding Displays.ApplyPresetCommand}" CommandParameter="0.25" />
                    <Button Style="{StaticResource TidalChipButton}" Padding="0,5" Margin="-1,0,0,0" Content="50%"
                            Command="{Binding Displays.ApplyPresetCommand}" CommandParameter="0.5" />
                    <Button Style="{StaticResource TidalChipButton}" Padding="0,5" Margin="-1,0,0,0" Content="75%"
                            Command="{Binding Displays.ApplyPresetCommand}" CommandParameter="0.75" />
                    <Button Style="{StaticResource TidalChipButton}" Padding="0,5" Margin="-1,0,0,0" Content="100%"
                            Command="{Binding Displays.ApplyPresetCommand}" CommandParameter="1" />
                </UniformGrid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="16,12,16,14">
                <ToggleButton Style="{StaticResource TidalChipToggle}" HorizontalAlignment="Left"
                              IsChecked="{Binding Displays.LinkAll}"
                              AutomationProperties.Name="Link all"
                              ToolTip="Move every display's brightness together">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Link16" FontSize="13" />
                        <TextBlock Text="Link all" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TidalChipButton}" Click="OnSettingsClick" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings16" FontSize="13" />
                            <TextBlock Text="Settings" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TidalChipButton}" Margin="-1,0,0,0" Click="OnQuitClick"
                            AutomationProperties.Name="Quit Tidal" ToolTip="Quit Tidal">
                        <ui:SymbolIcon Symbol="Power20" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
