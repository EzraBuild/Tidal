<ui:FluentWindow x:Class="Tidal.App.Tray.TrayPopup"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Tidal.App.ViewModels"
                 xmlns:behaviors="clr-namespace:Tidal.App.Behaviors"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:DisplayListViewModel}"
                 Title="Tidal"
                 Width="360"
                 MinWidth="0"
                 MinHeight="0"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round">

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="20,18,20,6">
            <TextBlock Text="{Binding EmptyMessage}" Margin="0,4,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmptyMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Displays}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <Grid Margin="0,4,0,0"
                                  Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="BrightnessHigh20" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                        behaviors:SliderWheel.Step="2"
                                        AutomationProperties.Name="{Binding Name, StringFormat={}{0} brightness}"
                                        Value="{Binding Brightness}" />
                                <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <TextBlock Margin="24,6,0,0" FontSize="12" Text="No hardware control"
                                       ToolTip="{Binding Note}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="1" Padding="20,6,10,6" BorderThickness="0,1,0,0"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <ui:ToggleSwitch Content="Link all" VerticalAlignment="Center"
                                 IsChecked="{Binding LinkAll}"
                                 ToolTip="Move every display's brightness together" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Transparent" Padding="8" BorderThickness="0"
                               Icon="{ui:SymbolIcon ArrowClockwise20}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Detect displays again"
                               AutomationProperties.Name="Detect displays again" />
                    <ui:Button Appearance="Transparent" Padding="8" BorderThickness="0"
                               Icon="{ui:SymbolIcon Settings20}"
                               Click="OnDisplaysClick"
                               ToolTip="Display details"
                               AutomationProperties.Name="Display details" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
