<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Tidal.App.Controls">

    <!-- Tidal's controls. Colours (Tidal*Brush) are set at runtime by TidalTheme for light/dark. -->

    <FontFamily x:Key="TidalDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <controls:SliderFillConverter x:Key="SliderFill" />

    <!-- ===== Text ===== -->

    <Style x:Key="TidalEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="TidalTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TidalDisplayFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="TidalCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="TidalDialLabel" TargetType="TextBlock" BasedOn="{StaticResource TidalEyebrow}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- ===== Big numbers ===== -->

    <Style TargetType="controls:NumberDial">
        <Setter Property="FontFamily" Value="{StaticResource TidalDisplayFont}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TidalSunBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TidalOceanBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="Scroll, use the arrow keys, or type a number" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NumberDial">
                    <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalChipBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalChipHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The CURRENT value sits on a soft tinted card. -->
    <Style x:Key="TidalCurrentCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,2,0,4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource TidalSunSoftBrush}" />
    </Style>

    <!-- ===== Pill slider ===== -->

    <Style x:Key="TidalTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalSliderFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource TidalOceanBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thick rounded slider: icon inside the track, the value inside the thumb.
         Foreground is the fill colour; Tag is the SymbolRegular icon. -->
    <Style x:Key="TidalSlider" TargetType="Slider">
        <Setter Property="Height" Value="30" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TidalSunBrush}" />
        <Setter Property="Tag" Value="{x:Static ui:SymbolRegular.BrightnessHigh20}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TidalSliderFocus}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Height="{TemplateBinding Height}" Background="Transparent">
                        <Border CornerRadius="15" Background="{DynamicResource TidalTrackBrush}" />
                        <Border HorizontalAlignment="Left" CornerRadius="15" Background="{TemplateBinding Foreground}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource SliderFill}" ConverterParameter="30">
                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualWidth" ElementName="Root" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="15" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TidalOnSunBrush}" IsHitTestVisible="False" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TidalTrackButton}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TidalTrackButton}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="30" Height="30" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse Margin="3" Fill="{DynamicResource TidalKnobBrush}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.3" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TidalKnobTextBrush}"
                                                           Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalContrastSlider" TargetType="Slider" BasedOn="{StaticResource TidalSlider}">
        <Setter Property="Foreground" Value="{DynamicResource TidalContrastBrush}" />
        <Setter Property="Tag" Value="{x:Static ui:SymbolRegular.DarkTheme20}" />
    </Style>

    <Style x:Key="TidalVolumeSlider" TargetType="Slider" BasedOn="{StaticResource TidalSlider}">
        <Setter Property="Foreground" Value="{DynamicResource TidalVolumeBrush}" />
        <Setter Property="Tag" Value="{x:Static ui:SymbolRegular.Speaker220}" />
    </Style>

    <!-- ===== Chips ===== -->

    <Style x:Key="TidalChip" TargetType="ButtonBase">
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource TidalChipBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalChipHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalChipButton" TargetType="Button" BasedOn="{StaticResource TidalChip}" />

    <Style x:Key="TidalChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource TidalChip}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TidalOceanBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TidalOnOceanBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small label on the monitor screen, e.g. "DDC/CI". -->
    <Style x:Key="TidalScreenBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource TidalSunBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TidalOnSunBrush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <!-- ===== Tabs (segmented) ===== -->

    <Style x:Key="TidalTabItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="9" Padding="16,7" Margin="1,0" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalChipBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalChipHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalTabs" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource TidalPanelBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="4">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TidalTabItem}" />
    </Style>

    <!-- ===== Choice tiles and segments ===== -->

    <Style x:Key="TidalModeTile" TargetType="RadioButton">
        <Setter Property="Margin" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="14" Padding="16,14" BorderThickness="2"
                            BorderBrush="Transparent" Background="{DynamicResource TidalPanelBrush}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalChipBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TidalOceanBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalOceanSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalSegment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="9" Padding="14,7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalChipBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalOceanBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TidalOnOceanBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Panels ===== -->

    <Style x:Key="TidalPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Background" Value="{DynamicResource TidalPanelBrush}" />
    </Style>
</ResourceDictionary>
