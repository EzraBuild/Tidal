<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Tidal.App.Controls">

    <!-- Tidal's controls: monochrome, square, thin borders. Colours (Tidal*Brush) come from
         TidalTheme, which sets them for light or dark. Fonts are embedded in the app. -->

    <FontFamily x:Key="TidalFont">pack://application:,,,/Assets/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="TidalMonoFont">pack://application:,,,/Assets/Fonts/#Geist Mono</FontFamily>

    <!-- WPF-UI's own controls: same font, nearly square. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Geist</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>

    <controls:SliderFillConverter x:Key="SliderFill" />

    <!-- ===== Text ===== -->

    <Style x:Key="TidalEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TidalMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TidalMutedBrush}" />
    </Style>

    <Style x:Key="TidalTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TidalFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TidalTextBrush}" />
    </Style>

    <Style x:Key="TidalCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TidalFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TidalMutedBrush}" />
    </Style>

    <Style x:Key="TidalDialLabel" TargetType="TextBlock" BasedOn="{StaticResource TidalEyebrow}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TidalFaintBrush}" />
        <Setter Property="Margin" Value="0,2,0,14" />
    </Style>

    <!-- ===== Big numbers ===== -->

    <Style TargetType="controls:NumberDial">
        <Setter Property="FontFamily" Value="{StaticResource TidalMonoFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TidalTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TidalTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TidalMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="Scroll, use the arrow keys, or type a number" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:NumberDial">
                    <Border x:Name="Bd" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TidalBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TidalMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The CURRENT value sits in a bordered box. -->
    <Style x:Key="TidalCurrentCard" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TidalBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource TidalSurfaceBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ===== Slider ===== -->

    <Style x:Key="TidalTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalSliderFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="1" BorderBrush="{DynamicResource TidalMutedBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A flat square slider: a solid fill ending in a square thumb that shows the value.
         Foreground is the fill colour; Tag is the SymbolRegular icon drawn on the fill. -->
    <Style x:Key="TidalSlider" TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TidalInvertBrush}" />
        <Setter Property="Tag" Value="{x:Static ui:SymbolRegular.BrightnessHigh20}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TidalSliderFocus}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Height="{TemplateBinding Height}" Background="Transparent">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource TidalBorderBrush}" Background="{DynamicResource TidalTrackBrush}" />
                        <Border HorizontalAlignment="Left" Background="{TemplateBinding Foreground}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource SliderFill}" ConverterParameter="28">
                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualWidth" ElementName="Root" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="14" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TidalOnInvertBrush}" IsHitTestVisible="False" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TidalTrackButton}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TidalTrackButton}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="28" Height="28" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border BorderThickness="1" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                    Background="{DynamicResource TidalBackgroundBrush}">
                                                <TextBlock FontFamily="{StaticResource TidalMonoFont}" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TidalTextBrush}"
                                                           Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalContrastSlider" TargetType="Slider" BasedOn="{StaticResource TidalSlider}">
        <Setter Property="Foreground" Value="{DynamicResource TidalSecondaryFillBrush}" />
        <Setter Property="Tag" Value="{x:Static ui:SymbolRegular.DarkTheme20}" />
    </Style>

    <Style x:Key="TidalVolumeSlider" TargetType="Slider" BasedOn="{StaticResource TidalSlider}">
        <Setter Property="Foreground" Value="{DynamicResource TidalSecondaryFillBrush}" />
        <Setter Property="Tag" Value="{x:Static ui:SymbolRegular.Speaker220}" />
    </Style>

    <!-- ===== Buttons ===== -->

    <Style x:Key="TidalChip" TargetType="ButtonBase">
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontFamily" Value="{StaticResource TidalFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TidalTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource TidalBorderBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TidalBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalChipButton" TargetType="Button" BasedOn="{StaticResource TidalChip}" />

    <!-- Solid, inverted: the one main action in a view. -->
    <Style x:Key="TidalPrimaryButton" TargetType="Button" BasedOn="{StaticResource TidalChip}">
        <Setter Property="Background" Value="{DynamicResource TidalInvertBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TidalInvertBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TidalOnInvertBrush}" />
    </Style>

    <Style x:Key="TidalChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource TidalChip}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TidalInvertBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TidalInvertBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TidalOnInvertBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small bordered label, e.g. "DDC/CI" or "AUTO". -->
    <Style x:Key="TidalTag" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TidalBorderStrongBrush}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource TidalMonoFont}" />
        <Setter Property="TextElement.FontSize" Value="10" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TidalMutedBrush}" />
    </Style>

    <!-- ===== Tabs and segments ===== -->

    <Style x:Key="TidalTabItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource TidalFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TidalMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Padding="16,7" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TidalTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalInvertBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TidalOnInvertBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalTabs" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource TidalBorderBrush}"
                            Background="{DynamicResource TidalBackgroundBrush}" Padding="3">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TidalTabItem}" />
    </Style>

    <Style x:Key="TidalModeTile" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TidalTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Padding="16,14" BorderThickness="1" Margin="-1,0,0,0"
                            BorderBrush="{DynamicResource TidalBorderBrush}" Background="{DynamicResource TidalBackgroundBrush}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TidalTextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalSurfaceBrush}" />
                            <Setter TargetName="Bd" Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TidalSegment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource TidalFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TidalMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Padding="14,7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TidalInvertBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TidalOnInvertBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Panels and lines ===== -->

    <Style x:Key="TidalPanel" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TidalBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource TidalBackgroundBrush}" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!-- Dashed divider lines, Better Auth style. -->
    <Style x:Key="TidalDashedLine" TargetType="Rectangle">
        <Setter Property="Stroke" Value="{DynamicResource TidalBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="4 4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</ResourceDictionary>
