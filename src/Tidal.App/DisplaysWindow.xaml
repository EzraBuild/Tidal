<ui:FluentWindow x:Class="Tidal.App.DisplaysWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Tidal.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:DisplayListViewModel}"
                 Title="Tidal Displays"
                 Width="520" Height="620" MinWidth="420" MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- One card per display. -->
        <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
            <Border Margin="0,0,0,12" Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="28" Margin="0,0,14,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Primary" FontSize="11"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Details}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8"
                                   Icon="{ui:SymbolIcon ArrowClockwise20}"
                                   Command="{Binding RefreshCommand}"
                                   ToolTip="Read current values from the display" />
                    </Grid>

                    <Grid Margin="0,16,0,0" Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="BrightnessHigh20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Brightness" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Slider Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                Value="{Binding Brightness}" />
                        <TextBlock Grid.Column="3" Text="{Binding Brightness, StringFormat={}{0:0}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid Margin="0,8,0,0" Visibility="{Binding SupportsContrast, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DarkTheme20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Contrast" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Slider Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                Value="{Binding Contrast}" />
                        <TextBlock Grid.Column="3" Text="{Binding Contrast, StringFormat={}{0:0}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ui:InfoBar Margin="0,12,0,0" Severity="Warning" IsClosable="False"
                                Title="No hardware control"
                                Message="{Binding Note}"
                                IsOpen="{Binding HasNote, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Tidal Displays" />

        <Grid Grid.Row="1" Margin="20,8,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Displays" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="Detect again" VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise20}"
                       Command="{Binding RefreshCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="2" Padding="20,0,20,8" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Displays}" />
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" Margin="0,40,0,0"
                                 VerticalAlignment="Top" HorizontalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
