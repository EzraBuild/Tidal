<ui:FluentWindow x:Class="Tidal.App.Osd.BrightnessOsd"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Tidal brightness level"
                 Width="240"
                 MinWidth="0"
                 MinHeight="0"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowActivated="False"
                 Focusable="False"
                 Topmost="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round">
    <Grid Margin="18,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="20" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ProgressBar x:Name="LevelBar" Grid.Column="1" Minimum="0" Maximum="100" Margin="12,0"
                     VerticalAlignment="Center" />
        <TextBlock x:Name="LevelText" Grid.Column="2" FontSize="14"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    </Grid>
</ui:FluentWindow>
