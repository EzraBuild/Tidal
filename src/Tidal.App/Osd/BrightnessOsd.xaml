<ui:FluentWindow x:Class="Tidal.App.Osd.BrightnessOsd"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Tidal brightness level"
                 Width="240"
                 MinWidth="0"
                 MinHeight="0"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowActivated="False"
                 Focusable="False"
                 Topmost="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="RoundSmall"
                 FontFamily="{StaticResource TidalFont}"
                 Background="{DynamicResource TidalBackgroundBrush}"
                 Foreground="{DynamicResource TidalTextBrush}">
    <Border BorderThickness="1" BorderBrush="{DynamicResource TidalBorderStrongBrush}" Background="{DynamicResource TidalBackgroundBrush}">
        <Grid Margin="16,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="18" VerticalAlignment="Center" />
            <!-- Level bar: the fill and the rest share the width in proportion to the level. -->
            <Grid Grid.Column="1" Height="4" Margin="12,0" VerticalAlignment="Center" Background="{DynamicResource TidalTrackBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FillColumn" Width="0*" />
                    <ColumnDefinition x:Name="RestColumn" Width="100*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource TidalInvertBrush}" />
            </Grid>
            <TextBlock x:Name="LevelText" Grid.Column="2" FontFamily="{StaticResource TidalMonoFont}" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Border>
</ui:FluentWindow>
