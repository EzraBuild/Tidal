<UserControl x:Class="Tidal.App.Controls.ModePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Tidal.ViewModels;assembly=Tidal.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdaptiveViewModel}">
    <!-- A pill showing the adaptive mode; click to choose another. DataContext: AdaptiveViewModel. -->
    <Button x:Name="PickerButton" Style="{StaticResource TidalChipButton}" Padding="10,6,8,6"
            Click="OnClick" AutomationProperties.Name="Adaptive mode" ToolTip="What brightness follows">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <!-- Solid while adaptive brightness is on, faint when manual. -->
                        <Setter Property="Fill" Value="{DynamicResource TidalTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Off">
                                <Setter Property="Fill" Value="{DynamicResource TidalFaintBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ModeLabel}" VerticalAlignment="Center" />
            <ui:SymbolIcon Symbol="ChevronDown12" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Button.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Manual" IsCheckable="True" IsChecked="{Binding IsOff}" />
                <MenuItem Header="Follow the sun" IsCheckable="True" IsChecked="{Binding IsSun}" />
                <MenuItem Header="Match the built-in display" IsCheckable="True" IsChecked="{Binding IsBuiltIn}"
                          IsEnabled="{Binding IsBuiltInAvailable}" />
                <MenuItem Header="Follow the light sensor" IsCheckable="True" IsChecked="{Binding IsSensor}"
                          IsEnabled="{Binding IsSensorAvailable}" />
            </ContextMenu>
        </Button.ContextMenu>
    </Button>
</UserControl>
